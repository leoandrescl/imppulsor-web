<div class="no-ellipse">
<?php
/**
 * Plantilla individual para Insights — versión estandarizada
 */
if (!defined('ABSPATH')) exit;

get_header();

// HERO GLOBAL
get_template_part('template-parts/heros/hero', 'default');
?>
</div>

<div class="bg-light py-60 mt-0">
<main class="container grid-2 grid-2--2fr-1fr text-dark">

<?php while (have_posts()) : the_post();

  $autores  = get_field('autor_relacionado');
  $autor    = (is_array($autores) && !empty($autores)) ? $autores[0] : null;
  $contenido = get_field('contenido_insight');

  // INFO AUTOR (mismo esquema que en Casos de Éxito)
  if ($autor) {
    $foto     = get_field('foto_autor',     $autor->ID);
    $cargo    = get_field('cargo_autor',    $autor->ID);
    $empresa  = get_field('empresa_autor',  $autor->ID);
    $linkedin = get_field('linkedin_autor', $autor->ID);
    $bio      = get_field('bio_autor',      $autor->ID);
    $pais     = get_field('pais_autor',     $autor->ID);
    $anio     = get_field('anio_autor',     $autor->ID); // opcional, por si lo usas después
  }
?>

<!-- ======================================================
     CONTENIDO PRINCIPAL
======================================================= -->
<section class="main-content reveal reveal-right">

<?php
  // TAG PRINCIPAL
  $tags = get_the_terms(get_the_ID(), 'tags_insight');
  $tag_name = ($tags && !is_wp_error($tags)) ? esc_html($tags[0]->name) : '';
?>

<?php if ($tag_name): ?>
  <span class="px-10 font-bold bg-light-blue text-white text-bold d-inline-block"><?php echo $tag_name; ?></span>
<?php endif; ?>

<h1 class="heading-lg mt-20 mb-20"><?php the_title(); ?></h1>

<?php if ($autor): ?>
  <!-- BLOQUE AUTOR (idéntico en estructura al de Casos de Éxito) -->
  <div class="d-flex align-center justify-between text-dark" data-open-autor>

    <div class="d-flex align-center">

      <?php if ($foto): ?>
        <img class="autor-foto rounded-full" src="<?php echo esc_url($foto['url']); ?>" alt="<?php echo esc_attr($autor->post_title); ?>" width="48" height="48">
      <?php else: ?>
        <div class="autor-foto--placeholder rounded-full bg-light-gray" style="width:48px; height:48px;"></div>
      <?php endif; ?>

      <strong class="text-dark mx-20"><?php echo esc_html($autor->post_title); ?></strong>

      <?php if ($linkedin): ?>
        <a href="<?php echo esc_url($linkedin); ?>" target="_blank" rel="noopener" class="autor-linkedin fs-16 text-bold text-dark" aria-label="LinkedIn del autor">in</a>
      <?php endif; ?>

    </div>

    <!-- Fecha del insight (mantengo tu formato original) -->
    <span><?php echo esc_html(get_the_date('j \d\e F, Y')); ?></span>

  </div>

  <!-- MODAL AUTOR (misma estructura/clases que en Casos de Éxito) -->
  <?php if ($bio): ?>
    <div class="autor-modal" id="autorModal" aria-hidden="true">
      <div class="autor-modal__overlay" data-close-autor></div>

      <div class="autor-modal__dialog" role="dialog" aria-modal="true">
        <button class="autor-modal__close" type="button" aria-label="Cerrar" data-close-autor>×</button>

        <div class="autor-modal__header">

          <?php if ($foto): ?>
            <img class="autor-foto grande" src="<?php echo esc_url($foto['url']); ?>" alt="<?php echo esc_attr($autor->post_title); ?>">
          <?php endif; ?>

          <div>
            <h3><?php echo esc_html($autor->post_title); ?></h3>

            <!-- Cargo y empresa -->
            <?php if ($cargo || $empresa): ?>
              <p class="autor-cargo-empresa">
                <?php echo esc_html($cargo); ?>
                <?php if ($cargo && $empresa) echo ' — '; ?>
                <?php echo esc_html($empresa); ?>
              </p>
            <?php endif; ?>

            <!-- País -->
            <?php if ($pais): ?>
              <p class="autor-pais"><?php echo esc_html($pais); ?></p>
            <?php endif; ?>

            <!-- LinkedIn -->
            <?php if ($linkedin): ?>
              <p>
                <a href="<?php echo esc_url($linkedin); ?>" target="_blank" rel="noopener" class="autor-linkedin">
                  <img src="/wp-content/uploads/icon-in.png" alt="LinkedIn" width="24" height="24">
                </a>
              </p>
            <?php endif; ?>

          </div>

        </div>

        <div class="autor-modal__body">
          <?php echo wpautop($bio); ?>
        </div>

      </div>
    </div>
  <?php endif; ?>

<?php endif; ?>

<div class="separator-40y"></div>

<div class="content-body">
  <?php echo wp_kses_post($contenido ?: get_the_content()); ?>
</div>

<div class="acciones mt-40">
  <a href="https://www.linkedin.com/sharing/share-offsite/?url=<?php echo urlencode(get_permalink()); ?>" target="_blank" rel="noopener">
    <img src="/wp-content/uploads/icon-compartir.svg" width="21" alt="Compartir"> Compartir
  </a>
  <a href="javascript:void(0)" onclick="window.print()">
    <img src="/wp-content/uploads/icon-imprimir.svg" width="17" alt="Imprimir"> Imprimir
  </a>
  <a href="<?php echo esc_url(get_stylesheet_directory_uri() . '/inc/generar-pdf.php?id=' . get_the_ID()); ?>">
    <img src="/wp-content/uploads/icon-descargar.svg" width="25" alt="Descargar PDF"> Descargar PDF
  </a>
</div>

</section>

<!-- ===========================
     SIDEBAR DERECHA
=========================== -->
<aside class="sidebar reveal reveal-left">

  <!-- Buscador -->
  <div class="sidebar-block mb-40 bg-light-gray py-20 px-20">
    <h3 class="heading-sm mb-15">Buscador</h3>
    <form method="get" action="<?php echo esc_url(home_url('/')); ?>">
      <input type="hidden" name="post_type" value="insights">
      <input type="search" name="s" placeholder="Ingrese palabra clave…" class="w-100">
    </form>
  </div>

  <!-- Taxonomías -->
  <div class="sidebar-block mb-40 bg-light-gray py-20 px-20">
    <h3 class="heading-sm mb-15">Áreas de gestión</h3>
    <ul class="list-unstyled">
      <?php
        $tags = get_terms([
          'taxonomy' => 'tags_insight',
          'hide_empty' => true,
          'orderby' => 'count',
          'order' => 'DESC',
        ]);

        $page_insights = get_page_by_path('insights');
        $base_url = $page_insights ? get_permalink($page_insights->ID) : home_url('/insights/');
      ?>

      <?php if ($tags && !is_wp_error($tags)): ?>
        <?php foreach ($tags as $tag):
          $link = add_query_arg('tag', $tag->slug, $base_url); ?>
          <li>
            <a href="<?php echo esc_url($link); ?>" class="d-flex justify-between py-5 px-10 text-dark">
              <span><?php echo esc_html($tag->name); ?></span>
              <span>(<?php echo intval($tag->count); ?>)</span>
            </a>
          </li>
        <?php endforeach; ?>
      <?php endif; ?>
    </ul>
  </div>

  <!-- Autores -->
  <div class="sidebar-block bg-light-gray py-20 px-20">
    <h3 class="heading-sm mb-20">Autores recientes</h3>

    <?php
      $autores_rec = [];
      $posts_autores = get_posts([
        'post_type' => 'insights',
        'numberposts' => 20,
        'post_status' => 'publish',
      ]);

      foreach ($posts_autores as $p) {
        $autor_rel = get_field('autor_relacionado', $p->ID);
        if (is_array($autor_rel) && !empty($autor_rel)) {
          $autor_id = $autor_rel[0]->ID;
          $nombre = get_the_title($autor_id);

          if (!isset($autores_rec[$nombre])) {
            $autores_rec[$nombre] = [
              'foto'     => get_field('foto_autor', $autor_id),
              'cargo'    => get_field('cargo_autor', $autor_id),
              'linkedin' => get_field('linkedin_autor', $autor_id),
            ];
          }
        }
      }

      $autores_rec = array_slice($autores_rec, 0, 3);
    ?>

    <?php foreach ($autores_rec as $nombre => $data): ?>
      <div class="d-flex align-center mb-20 bg-light text-dark">
        <?php if (!empty($data['foto']['url'])): ?>
          <img src="<?php echo esc_url($data['foto']['url']); ?>" class="autor-foto" style="width:70px; height:70px;">
        <?php endif; ?>

        <div class="px-10" style="flex:1;">
          <strong class="fs-14"><?php echo esc_html($nombre); ?></strong>
          <?php if (!empty($data['cargo'])): ?>
            <span class="fs-12"><?php echo esc_html($data['cargo']); ?></span>
          <?php endif; ?>
        </div>

        <?php if (!empty($data['linkedin'])): ?>
          <a href="<?php echo esc_url($data['linkedin']); ?>" target="_blank" rel="noopener" class="text-bold fs-18 px-10">in</a>
        <?php endif; ?>

      </div>
    <?php endforeach; ?>

  </div>

</aside>

<?php endwhile; ?>
</main>
</div>


<!-- ============================================================
     OTROS INSIGHTS RELACIONADOS DEL AUTOR (FUERA DEL MAIN)
============================================================ -->
<?php
if ($autor) {

  $relacionados = new WP_Query([
    'post_type' => 'insights',
    'posts_per_page' => 10,
    'post__not_in' => [get_the_ID()],
    'meta_query' => [
      [
        'key' => 'autor_relacionado',
        'value' => '"' . $autor->ID . '"',
        'compare' => 'LIKE',
      ]
    ]
  ]);

  if ($relacionados->have_posts()):
?>

<section class="bg-gradiente-13 text-white py-60 reveal reveal-up">
  <div class="container">

    <div class="grid-2--35-65">

      <!-- Izquierda -->
      <div>
        <h2 class="heading-lg mb-40">Otros insights relacionados del autor</h2>

        <div class="nav-round-group">
          <button class="nav-round nav-round--prev"></button>
          <button class="nav-round nav-round--next"></button>
        </div>
      </div>

      <!-- Derecha -->
      <div>
        <div class="swiper insights-relacionados-slider">
          <div class="swiper-wrapper">

          <?php while ($relacionados->have_posts()): $relacionados->the_post();

            $anio = get_the_date('Y');
            $tags = get_the_terms(get_the_ID(), 'tags_insight');
            $tag_name = ($tags && !is_wp_error($tags)) ? esc_html($tags[0]->name) : '';
            $nombre_autor = $autor->post_title;
            $imagen = get_the_post_thumbnail_url(get_the_ID(), 'large');
          ?>

            <div class="swiper-slide">

              <div class="w-100" style="height:280px; overflow:hidden;">
                <?php if ($imagen): ?>
                  <img src="<?php echo esc_url($imagen); ?>" class="w-100 h-100 object-cover">
                <?php else: ?>
                  <div class="bg-light-gray w-100 h-100"></div>
                <?php endif; ?>
              </div>

              <div class="mt-20">
                <p class="text-light-gray mb-5">
                  <?php echo esc_html($anio); ?>
                  <?php if ($tag_name): ?> | <?php echo $tag_name; ?><?php endif; ?>
                </p>

                <h3 class="heading-sm text-white mb-10 truncate-2"><?php the_title(); ?></h3>

                <p class="text-light-gray mb-20"><?php echo esc_html($nombre_autor); ?></p>

                <a href="<?php the_permalink(); ?>" class="btn-outline--white">Leer más</a>
              </div>

            </div>

          <?php endwhile; wp_reset_postdata(); ?>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<?php
  endif;
}
?>

<?php get_footer(); ?>


<script>
document.addEventListener('DOMContentLoaded', function () {
  const slider = document.querySelector('.insights-relacionados-slider');
  if (!slider || typeof Swiper === 'undefined') return;

  new Swiper(slider, {
    slidesPerView: 2,
    spaceBetween: 32,
    navigation: {
      nextEl: '.nav-round--next',
      prevEl: '.nav-round--prev'
    },
    breakpoints: {
      0:   { slidesPerView: 1, spaceBetween: 20 },
      768: { slidesPerView: 2, spaceBetween: 32 }
    }
  });
});
</script>
