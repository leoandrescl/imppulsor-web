RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
Header always set Content-Security-Policy "upgrade-insecure-requests;"

# 301 ES->EN migration 2026-09-19 (page slugs). Exact matches only.
RedirectMatch 301 ^/contacto/?$ /contact/
RedirectMatch 301 ^/soluciones/?$ /solutions/
RedirectMatch 301 ^/nosotros/?$ /about/
RedirectMatch 301 ^/clientes-y-socios-de-negocios/?$ /clients/
RedirectMatch 301 ^/casos-de-exito/?$ /success-stories/
RedirectMatch 301 ^/diagnosticos/?$ /diagnostics/
RedirectMatch 301 ^/diagnostico-de-madurez-comercial/?$ /commercial-maturity-diagnostic/
