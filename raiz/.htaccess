RedirectMatch 301 ^/diagnostico-de-madurez-comercial-3/?$ /commercial-maturity-diagnostic-3/
RedirectMatch 301 ^/diagnosticos-para-crecimiento-mk-y-productividad-comercial/?$ /growth-marketing-and-sales-productivity/
RedirectMatch 301 ^/referidos/?$ /referrals/
RedirectMatch 301 ^/equipo/?$ /team/
RedirectMatch 301 ^/soluciones-para-estrategia-y-gobierno/?$ /strategy-and-governance/
RedirectMatch 301 ^/soluciones-para-finanzas-y-control/?$ /finance-and-control/
RedirectMatch 301 ^/soluciones-para-innovacion-y-modelo-de-negocios/?$ /innovation-and-business-model/
RedirectMatch 301 ^/soluciones-para-cambio-y-transformacion/?$ /change-and-transformation/
RedirectMatch 301 ^/soluciones-para-personas-y-cultura/?$ /people-and-culture/
RedirectMatch 301 ^/soluciones-para-operaciones-y-procesos/?$ /operations-and-processes/
RedirectMatch 301 ^/soluciones-para-tecnologia-y-datos/?$ /technology-and-data/
RedirectMatch 301 ^/soluciones-para-crecimiento-mk-y-productividad-comercial/?$ /growth-marketing-and-sales-productivity/
RedirectMatch 301 ^/politica-de-privacidad/?$ /privacy-policy/
RedirectMatch 301 ^/politica-de-cookies/?$ /cookie-policy/
